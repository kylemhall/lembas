# The settings of make dev: cp .env.example .env, then fill it in. Never commit .env.
# The rest of the configuration is in compose.yml.

# A Google OAuth client, "Web application", with http://localhost:8080/auth/callback as redirect URI
LEMBAS_OIDC_CLIENT_ID=
LEMBAS_OIDC_CLIENT_SECRET=

# Who can sign in, and who is an admin
LEMBAS_ALLOWED_DOMAIN=bywatersolutions.com
LEMBAS_ADMIN_EMAILS=

# Optional
# LEMBAS_SHORT_URL=http://localhost:8080
# LEMBAS_SECRETS=at-least-16-characters
# LEMBAS_LOG_LEVEL=debug
