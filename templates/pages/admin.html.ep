% layout 'default';
% title 'Admin';
<section x-data="adminUsers" class="mb-5">
    <h1 class="h4">Users</h1>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Name</th>
                    <th class="text-end">Links</th>
                    <th>Last sign-in</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <template x-for="user in users" :key="user.id">
                    <tr :class="user.is_active ? '' : 'text-body-tertiary'">
                        <td>
                            <span x-text="user.email"></span>
                            <span class="badge text-bg-primary" x-show="user.is_admin">admin</span>
                            <span class="badge text-bg-secondary" x-show="user.is_active ? false : true">disabled</span>
                        </td>
                        <td x-text="user.name"></td>
                        <td class="text-end" x-text="user.links_count"></td>
                        <td x-text="user.last_login_at ? user.last_login_at.substring(0, 10) : 'never'"></td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary" type="button" x-on:click="toggle(user)"
                                x-text="user.is_active ? 'Disable' : 'Enable'"></button>
                        </td>
                    </tr>
                </template>
            </tbody>
        </table>
    </div>
</section>
%= include 'pages/_links', heading => 'Every link', all => 1
