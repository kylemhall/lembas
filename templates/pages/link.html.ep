% layout 'default';
% title "Stats of $ending";
<section x-data="linkStats" data-ending="<%= $ending %>">
    <p><a href="/">Back to the links</a></p>
    <div class="alert alert-danger" x-cloak x-show="error" x-text="error"></div>
    <div x-cloak x-show="link">
        <h1 class="h4 mb-1" x-text="link ? link.short_url : ''"></h1>
        <p class="text-break text-body-secondary" x-text="link ? link.long_url : ''"></p>
        <div class="d-flex flex-wrap align-items-center gap-3 my-3">
            <div class="btn-group" role="group" aria-label="Period">
                <button type="button" :class="days === 7 ? 'btn btn-primary' : 'btn btn-outline-primary'" x-on:click="setRange(7)">7 days</button>
                <button type="button" :class="days === 30 ? 'btn btn-primary' : 'btn btn-outline-primary'" x-on:click="setRange(30)">30 days</button>
                <button type="button" :class="days === 90 ? 'btn btn-primary' : 'btn btn-outline-primary'" x-on:click="setRange(90)">90 days</button>
                <button type="button" :class="days === 365 ? 'btn btn-primary' : 'btn btn-outline-primary'" x-on:click="setRange(365)">A year</button>
            </div>
            <span class="fs-4"><span class="fw-semibold" x-text="total"></span> clicks</span>
            <span class="text-body-secondary">(<span x-text="link ? link.clicks : ''"></span> since it was made)</span>
        </div>
        <div class="row g-4">
            <div class="col-lg-8">
                <h2 class="h6">Clicks per day (UTC)</h2>
                <table class="table table-sm align-middle">
                    <tbody>
                        <template x-for="day in perDay" :key="day.day">
                            <tr>
                                <td class="text-nowrap" x-text="day.day"></td>
                                <td class="w-100"><progress class="w-100" :value="day.clicks" :max="maxClicks"></progress></td>
                                <td class="text-end" x-text="day.clicks"></td>
                            </tr>
                        </template>
                    </tbody>
                </table>
                <p class="text-body-secondary" x-show="perDay.length === 0">No clicks in this period.</p>
            </div>
            <div class="col-lg-4">
                <h2 class="h6">Top referers</h2>
                <table class="table table-sm">
                    <tbody>
                        <template x-for="referer in referers" :key="referer.host">
                            <tr>
                                <td class="text-break" x-text="referer.host ? referer.host : 'Direct, or no referer'"></td>
                                <td class="text-end" x-text="referer.clicks"></td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
